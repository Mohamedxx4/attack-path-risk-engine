# ──────────────────────────────────────────────────────────────────────────
# Attack Path Risk Engine — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ──────────────────────────────────────────────────────────────────────────

# Backend API base URL (used in production builds).
# In development the Vite proxy forwards /api → backend (see vite.config.js).
VITE_API_BASE_URL=/api

# Optional: Bearer token if your backend requires authentication.
# VITE_API_TOKEN=your_token_here
